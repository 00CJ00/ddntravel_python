# Copia este archivo a ".env" y completa tus valores reales.
# ¡NUNCA subas tu archivo .env a GitHub!

# Clave de la API de Google Gemini (opcional, la app funciona con datos simulados sin ella)
GEMINI_API_KEY=pega_aqui_tu_clave

# Clave secreta de Flask para las sesiones (cambiala por algo largo y aleatorio)
SECRET_KEY=genera_una_clave_aleatoria_larga

# Credenciales de OAuth de Google Cloud (opcional, habilitan "Continuar con Google")
# Crealas en https://console.cloud.google.com/apis/credentials > OAuth 2.0 Client ID
# URI de redireccion autorizada: http://localhost:3000/login/google/authorized
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google
