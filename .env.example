# Copia este archivo a ".env" y completa tus valores reales.
# ¡NUNCA subas tu archivo .env a GitHub!

# Clave de la API de Google Gemini (opcional, la app funciona con datos simulados sin ella)
GEMINI_API_KEY=pega_aqui_tu_clave

# Clave secreta de Flask para las sesiones (cambiala por algo largo y aleatorio)
SECRET_KEY=genera_una_clave_aleatoria_larga

# Credenciales de OAuth de Google Cloud (opcional, habilitan "Continuar con Google")
# Crealas en https://console.cloud.google.com/apis/credentials > OAuth 2.0 Client ID
# URI local de redirección: http://localhost:3000/login/google/authorized
# Para ngrok agrega también la URL HTTPS pública:
# https://<tu-dominio-ngrok>/login/google/authorized
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# Para cookies seguras cuando uses la URL HTTPS de ngrok (opcional en local):
# SESSION_COOKIE_SECURE=1

# Datos del emisor para las facturas (simulación académica, no DGII)
# AGENCY_RNC=131456789
# AGENCY_NAME=DDN Travel S.R.L.
# AGENCY_ADDRESS=Av. Winston Churchill 1052, Santo Domingo
# AGENCY_PHONE=+1 (809) 555-0123

# Correo SMTP transaccional (opcional; sin configuración, los eventos se registran en el log)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=no-reply@example.com

# APScheduler diario (desactivado por defecto; en producción se recomienda cron externo)
ENABLE_SCHEDULER=0
